# ── LINE Messaging API ────────────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Google Sheets (service-account key, inline JSON) ─────────────
# Must be a JSON string with "type": "service_account" and a "private_key".
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key":"REPLACE_WITH_PRIVATE_KEY","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com"}

# ── Spreadsheets ──────────────────────────────────────────────────
# MASTER_SPREADSHEET_ID falls back to SPREADSHEET_ID when empty.
MASTER_SPREADSHEET_ID=
SPREADSHEET_ID=

# ── Test / sample-data spreadsheets (scripts/setup_sample_sheets.py) ──
# Required, and must DIFFER from the production ids above. The sample-data
# script aborts unless these are set, and never writes to production ids.
TEST_MASTER_SPREADSHEET_ID=
TEST_SPREADSHEET_ID=

# ── Misc ──────────────────────────────────────────────────────────
APP_VERSION=1.0.0
# LOG_LEVEL=INFO

# ── Structural sheet config (core/sheet_config.AppConfig) ────────
# pydantic-settings reads these case-insensitively.
PORTFOLIO_RANGE=Portfolio!A2:D
VALIDATION_RESULT_SHEET=ValidationResult
